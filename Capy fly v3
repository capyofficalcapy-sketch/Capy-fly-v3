local function applyTheme(colors)
    currentColors = colors
    panel.BackgroundColor3 = colors.background
    settingsPanel.BackgroundColor3 = colors.background
    outline.Color = colors.outline
    settingsOutline.Color = colors.outline

    for _, container in ipairs({panel, settingsPanel}) do
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("TextLabel") then
                child.TextColor3 = colors.text
            elseif child:IsA("TextButton") and child ~= dragHandle then
                child.BackgroundColor3 = colors.button
                child.TextColor3 = colors.white
            end
        end
    end
end

local function chooseTheme(name)
    currentThemeName = name
    animationMode = "Off"
    applyTheme(THEMES[name])
    rgbButton.Text = "🌈 RGB: OFF"
    rainbowButton.Text = "RAINBOW: OFF"
end

for name, button in pairs(themeButtons) do
    button.Activated:Connect(function()
        chooseTheme(name)
    end)
end

