local function createSpeedRow(y, amount, labelText)
    makeLabel(
        panel, "SpeedRow" .. labelText, labelText,
        UDim2.fromOffset(66, 29),
        UDim2.fromOffset(6, y), 12
    )

    local minus = makeButton(
        panel, "Minus" .. labelText, "−",
        UDim2.fromOffset(43, 29),
        UDim2.fromOffset(76, y)
    )
    minus.TextSize = 22

    local plus = makeButton(
        panel, "Plus" .. labelText, "+",
        UDim2.fromOffset(43, 29),
        UDim2.fromOffset(124, y)
    )
    plus.TextSize = 22

    minus.Activated:Connect(function()
        speedMultiplier = math.max(
            MIN_SPEED,
            math.floor((speedMultiplier - amount) * 100 + 0.5) / 100
        )
        updateSpeed()
    end)

    plus.Activated:Connect(function()
        speedMultiplier = math.min(
            MAX_SPEED,
            math.floor((speedMultiplier + amount) * 100 + 0.5) / 100
        )
        updateSpeed()
    end)
end

