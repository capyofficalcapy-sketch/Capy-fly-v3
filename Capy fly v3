local dragStart
local startPanelPosition

local function clampPanelPosition(position, panelSize)
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize

    if not viewport then
        return position
    end

    local width = panelSize.X.Offset
    local height = panelSize.Y.Offset

    local x = math.clamp(
        position.X.Offset,
        0,
        math.max(0, viewport.X - width)
    )

    local y = math.clamp(
        position.Y.Offset,
        0,
        math.max(0, viewport.Y - height)
    )

    return UDim2.fromOffset(x, y)
end

dragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPanelPosition = panel.Position
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        if dragInput
            and input.UserInputType == Enum.UserInputType.Touch
            and input ~= dragInput then
            return
        end

        local delta = input.Position - dragStart

        local newPosition = UDim2.new(
            startPanelPosition.X.Scale,
            startPanelPosition.X.Offset + delta.X,
            startPanelPosition.Y.Scale,
            startPanelPosition.Y.Offset + delta.Y
        )

        panel.Position = clampPanelPosition(newPosition, panel.Size)

        if settingsPanel then
            settingsPanel.Position = UDim2.new(
                panel.Position.X.Scale,
                panel.Position.X.Offset,
                panel.Position.Y.Scale,
                panel.Position.Y.Offset - settingsPanel.Size.Y.Offset - 8
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == dragInput
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        dragInput = nil
    end
end)

