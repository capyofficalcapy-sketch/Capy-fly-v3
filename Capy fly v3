--==================================================
-- CHARACTER HANDLING
--==================================================

local function getCharacter()
    character = player.Character or player.CharacterAdded:Wait()
    humanoid = character:WaitForChild("Humanoid")
    rootPart = character:WaitForChild("HumanoidRootPart")
end

local function stopFlying()
    flying = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end

    if flyGyro then
        flyGyro:Destroy()
        flyGyro = nil
    end

    if humanoid and humanoid.Parent then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end

    if flyButton and flyButton.Parent then
        flyButton.Text = "✈ FLY: OFF"
    end
end

--==================================================
-- FLYING: ORIGINAL V2 MOVEMENT
--==================================================

local function startFlying()
    getCharacter()

    if not humanoid or not rootPart or humanoid.Health <= 0 then
        return
    end

    if flyConnection then flyConnection:Disconnect() end
    if flyVelocity then flyVelocity:Destroy() end
    if flyGyro then flyGyro:Destroy() end

    flying = true
    flyButton.Text = "✈ FLY: ON"

    humanoid.AutoRotate = false
    humanoid.PlatformStand = true

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.Name = "CapyFlyVelocity"
    flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyVelocity.P = 1e4
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = rootPart

    flyGyro = Instance.new("BodyGyro")
    flyGyro.Name = "CapyFlyGyro"
    flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyGyro.P = 1e5
    flyGyro.D = 1e3
    flyGyro.CFrame = workspace.CurrentCamera.CFrame
    flyGyro.Parent = rootPart

    flyConnection = RunService.RenderStepped:Connect(function()
        if not flying or not rootPart or not rootPart.Parent
            or not humanoid or humanoid.Health <= 0 then
            stopFlying()
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then return end

        local moveDirection = humanoid.MoveDirection
        local look = camera.CFrame.LookVector

        local flatForward = Vector3.new(look.X, 0, look.Z)
        if flatForward.Magnitude > 0.001 then
            flatForward = flatForward.Unit
        else
            flatForward = Vector3.new(0, 0, -1)
        end

        local flatRight = Vector3.new(-flatForward.Z, 0, flatForward.X)
        local forwardAmount = moveDirection:Dot(flatForward)
        local rightAmount = moveDirection:Dot(flatRight)
        local currentSpeed = BASE_SPEED * speedMultiplier

        local horizontal = (
            flatForward * forwardAmount + flatRight * rightAmount
        ) * currentSpeed

        local vertical = forwardAmount * look.Y * currentSpeed
        flyVelocity.Velocity = horizontal + Vector3.new(0, vertical, 0)
        flyGyro.CFrame = camera.CFrame
    end)
end

flyButton.Activated:Connect(function()
    if flying then
        stopFlying()
    else
        startFlying()
    end
end)

