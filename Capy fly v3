end)

animationConnection = RunService.Heartbeat:Connect(function(dt)
    if animationMode == "Off" then return end

    local rate = animationMode == "Rainbow" and 0.32 or 0.10
    animationHue = (animationHue + dt * rate) % 1

    local hueColor = Color3.fromHSV(animationHue, 0.8, 1)
    local backgroundColor = Color3.fromHSV(
        (animationHue + 0.5) % 1,
        animationMode == "Rainbow" and 0.35 or 0.55,
        animationMode == "Rainbow" and 1 or 0.65
    )

    panel.BackgroundColor3 = backgroundColor
    settingsPanel.BackgroundColor3 = backgroundColor
    outline.Color = hueColor
    settingsOutline.Color = hueColor

    for _, container in ipairs({panel, settingsPanel}) do
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("TextButton") and child ~= dragHandle then
                child.BackgroundColor3 = hueColor
            end
        end
    end
end)

